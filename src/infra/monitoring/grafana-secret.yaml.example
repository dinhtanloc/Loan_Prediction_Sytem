# Example Kubernetes Secret manifest for Grafana admin password
# DO NOT commit real secrets. Copy this file to grafana-secret.yaml, fill the password locally
# and apply with kubectl, or create the secret directly with `kubectl create secret`.

apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: monitoring
type: Opaque
stringData:
  # Replace the value below with your real Grafana admin password before applying
  admin-password: "REPLACE_WITH_REAL_PASSWORD"
